# ============================================================
# AIREAK ENTERTAINMENT PLATFORM - ENVIRONMENT VARIABLES EXAMPLE
# ============================================================
# Copy file này thành `.env` và điền giá trị thật của bạn.
# KHÔNG BAO GIỜ commit file .env (đã có trong .gitignore)
# ============================================================

# ============================================================
# INFRASTRUCTURE
# ============================================================

# Docker images
# Lưu ý: Bitnami đã ngừng cung cấp image miễn phí trên Docker Hub từ 28/8/2025.
# Dùng image chính thức thay thế (mongo, apache/kafka).
MYSQL_IMAGE=mysql:8.0
MONGODB_IMAGE=mongo:7.0
KAFKA_IMAGE=apache/kafka:3.9.2
REDIS_IMAGE=redis:7-alpine
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.0

# Container names
MYSQL_CONTAINER_NAME=mysql
MONGODB_CONTAINER_NAME=mongodb
REDIS_CONTAINER_NAME=redis
ELASTICSEARCH_CONTAINER_NAME=elasticsearch

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=YOUR_MONGODB_ROOT_PASSWORD
# BẮT BUỘC cho replica set + authorization. Phải là chuỗi base64 hợp lệ
# (MongoDB 4.2+ từ chối keyFile không hợp lệ). Sinh key mới bằng:
#   openssl rand -base64 756
MONGODB_REPLICA_SET_KEY=YOUR_BASE64_REPLICA_SET_KEY_HERE

# Debezium CDC database account (used by MySQL, MongoDB and debezium-manager)
DEBEZIUM_DB_USERNAME=debezium
DEBEZIUM_DB_PASSWORD=YOUR_DEBEZIUM_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Kafka
# Lưu ý: service nội bộ docker dùng kafka:9092, máy host dùng localhost:9094
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=YOUR_ELASTICSEARCH_PASSWORD

# ============================================================
# SECURITY / AUTH
# ============================================================

# JWT - DÙNG CHUNG CHO TẤT CẢ SERVICES (phải giống nhau)
JWT_SIGNER_KEY=YOUR_PREPARED_512BIT_SECRET_KEY

# Google OAuth (identity-service)
CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
REDIRECT_URI=http://localhost:5173/authenticate
GRANT_TYPE=authorization_code

# JWT Duration (identity-service)
VALID_DURATION=3600
REFRESHABLE_DURATION=2592000

# Optional local/demo admin bootstrap. Never use a default password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=YOUR_STRONG_BOOTSTRAP_ADMIN_PASSWORD

# ============================================================
# SERVICE URLS (cho api-gateway và các service gọi nhau)
# ============================================================
# Khi chạy docker: dùng tên service nội bộ (http://identity:8080)
# Khi chạy local dev: dùng localhost (http://localhost:8080)

IDENTITY_SERVICE_URL=http://localhost:8080
PROFILE_SERVICE_URL=http://localhost:8081
PROFILES_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
POST_SERVICE_URL=http://localhost:8083
FILE_SERVICE_URL=http://localhost:8084
CHAT_SERVICE_URL=http://localhost:8086
FRIEND_SERVICE_URL=http://localhost:8087
SOCKET_SERVICE_URL=http://localhost:8088
SOCKET_SERVICE_WS_URL=ws://localhost:8088
COMMENT_SERVICE_URL=http://localhost:8089
FILM_SERVICE_URL=http://localhost:8090
ROOM_SERVICE_URL=http://localhost:8091
DEBEZIUM_CONNECT_URL=http://localhost:8100

# ============================================================
# EMAIL (notification-service - Brevo)
# ============================================================
BREVO_URL=https://api.brevo.com
BREVO_API_KEY=YOUR_BREVO_API_KEY
EMAIL_SENDER_NAME=aireak.com
EMAIL_SENDER_EMAIL=your-email@gmail.com

# ============================================================
# BACKBLAZE B2 (file-service)
# ============================================================
B2_KEY_ID=YOUR_B2_KEY_ID
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_BUCKET_NAME=YOUR_B2_BUCKET_NAME
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_PUBLIC=false
B2_PRESIGNED_URL_TTL=PT1H
B2_MULTIPART_CONCURRENCY=4
B2_HTTP_MAX_CONNECTIONS=64

# Origin công khai của api-gateway mà trình duyệt gọi tới (dùng để xây URL manifest HLS tuyệt đối,
# xem file-service FileService.hlsPlaylistUrl) - phải khớp VITE_API_BASE_URL bên dưới.
GATEWAY_PUBLIC_URL=http://localhost:8888/api/v1

# ============================================================
# FRONTEND (Vite - copy sang frontend/.env hoặc định nghĩa ở root)
# ============================================================
# VITE_API_BASE_URL phải trùng GATEWAY_PUBLIC_URL ở trên (trừ khi có proxy CORS khác)
VITE_API_BASE_URL=http://localhost:8888/api/v1
# VITE_SOCKET_URL: WebSocket endpoint public (nếu đi qua gateway thì ws://localhost:8888/ws, nếu direct thì ws://localhost:8088)
VITE_SOCKET_URL=ws://localhost:8888/ws

# File size limits (file-service)
MAX_FILE_SIZE=2GB
MAX_REQUEST_SIZE=2100MB
MAX_IMAGE_SIZE=25MB
MAX_VIDEO_SIZE=5GB
MAX_RAW_SIZE=100MB

# HLS processing (file-service)
HLS_SEGMENT_DURATION_SECONDS=10
HLS_FFMPEG_TIMEOUT_MINUTES=30
HLS_STALE_PROCESSING_MINUTES=45
HLS_POLL_INTERVAL_MS=3000

# Notification aggregation
LIKE_DEBOUNCE_SECONDS=5

# ============================================================
# MISC
# ============================================================
TZ=Asia/Ho_Chi_Minh
PUBLIC_RATE_LIMIT_ENABLED=true
